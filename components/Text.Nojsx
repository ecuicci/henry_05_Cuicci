import React from 'react';

const styles = {
  Text: {
    color: '#ffffff',
    fontSize: '18px',
    fontFamily: 'Roboto',
    fontWeight: 700,
    lineHeight: '28px',
  },
};

const defaultProps = {
  text: 'EduPortal',
};

const Text = (props) => {
  return (
    <div style={styles.Text}>
      {props.text ?? defaultProps.text}
    </div>
  );
};

export default Text;